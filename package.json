{
  "name": "dsh-context-show",
  "version": "0.9.0",
  "description": "Real-time context occupancy meter for DSH Web: draggable compact/detail panel, per-tool usage, settings-editable cost table (CNY/USD, flat or peak/off-peak), per-provider usage and token totals",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.client.json && tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "vitest run",
    "verify": "pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@deepseek-ai/dsh-client-ui-settings": "0.1.3-alpha.1",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "0.1.3-alpha.1",
    "@deepseek-ai/dsh-settings": "0.1.3-alpha.1",
    "@deepseek-ai/schemastery": "3.18.2",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-client-locale": "^0.1.3-alpha.1",
    "@deepseek-ai/dsh-client-store": "^0.1.3-alpha.1",
    "@deepseek-ai/dsh-client-ui-chat": "^0.1.3-alpha.1",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.1.3-alpha.1",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.1.3-alpha.1",
    "@deepseek-ai/dsh-client-ui-session": "^0.1.3-alpha.1",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.3-alpha.1",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "^0.1.3-alpha.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.3-alpha.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.3-alpha.1",
    "@deepseek-ai/dsh-llm": "^0.1.3-alpha.1",
    "@deepseek-ai/dsh-llm-retry": "^0.1.3-alpha.1",
    "@deepseek-ai/dsh-session": "^0.1.3-alpha.1",
    "@deepseek-ai/dsh-session-projection": "^0.1.3-alpha.1",
    "@deepseek-ai/dsh-settings": "^0.1.3-alpha.1",
    "@deepseek-ai/dsh-token-meter": "^0.1.3-alpha.1",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-locale": "0.1.3-alpha.1",
    "@deepseek-ai/dsh-client-store": "0.1.3-alpha.1",
    "@deepseek-ai/dsh-client-test-runtime": "0.1.3-alpha.1",
    "@deepseek-ai/dsh-client-ui-chat": "0.1.3-alpha.1",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.3-alpha.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.3-alpha.1",
    "@deepseek-ai/dsh-client-ui-session": "0.1.3-alpha.1",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.3-alpha.1",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "0.1.3-alpha.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.3-alpha.1",
    "@deepseek-ai/dsh-host-webserver": "0.1.3-alpha.1",
    "@deepseek-ai/dsh-llm": "0.1.3-alpha.1",
    "@deepseek-ai/dsh-llm-retry": "0.1.3-alpha.1",
    "@deepseek-ai/dsh-session": "0.1.3-alpha.1",
    "@deepseek-ai/dsh-session-projection": "0.1.3-alpha.1",
    "@deepseek-ai/dsh-settings": "0.1.3-alpha.1",
    "@deepseek-ai/dsh-token-meter": "0.1.3-alpha.1",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "jsdom": "26.0.0",
    "lightningcss": "^1.33.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "0.22.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.1"
  }
}
